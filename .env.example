# Existing Supabase public configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only privileged Supabase key: background notification worker only.
# Use the legacy service_role key or an equivalent Supabase server secret key.
SUPABASE_SERVICE_ROLE_KEY=

# OneSignal App ID is public; the App API key must remain server-only.
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# Gemini credentials and an available model ID with image + structured JSON support.
GEMINI_API_KEY=
GEMINI_MODEL=
# Distinct available fallback model with image + structured JSON support (server-only).
# Required for the V1 R-04 release gate; blank or identical to primary disables fallback.
GEMINI_FALLBACK_MODEL=

# Random server-only bearer secret for the scheduled notification endpoint.
CRON_SECRET=
# Canonical origin, e.g. https://your-app.vercel.app (no trailing slash).
APP_URL=
